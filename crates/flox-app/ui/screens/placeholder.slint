// A plain titled page used by every screen until its piece replaces it.
import { Tokens } from "../tokens.slint";

export component ScreenPlaceholder inherits Rectangle {
    in property <string> eyebrow;
    in property <string> heading;
    in property <string> caption;

    background: Tokens.canvas;

    VerticalLayout {
        padding: Tokens.screen-padding;
        spacing: Tokens.space-md;
        alignment: start;

        Text {
            text: root.eyebrow;
            font-family: Tokens.font-mono;
            font-size: Tokens.eyebrow-size;
            letter-spacing: Tokens.eyebrow-letter-spacing;
            color: Tokens.text-secondary;
        }

        Text {
            text: root.heading;
            font-family: Tokens.font-sans;
            font-weight: Tokens.weight-medium;
            font-size: Tokens.display-size;
            letter-spacing: Tokens.display-letter-spacing;
            color: Tokens.text-primary;
        }

        Text {
            text: root.caption;
            font-family: Tokens.font-sans;
            font-size: Tokens.caption-size;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }
    }
}
