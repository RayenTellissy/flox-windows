// Login: the QR code (280 px, black on white) left of a column with the TELEGRAM
// eyebrow, the heading, a mono status line (the scan instruction, CONNECTING, the
// step's prompt or the uppercased error), an optional body, the field (phone, code
// or masked password) and the buttons. The setup hint uses the same column. Steps
// and focus come from Rust (src/app/login_screen.rs, src/vm/login.rs).
import { Tokens } from "../tokens.slint";
import {
    Eyebrow, Heading, Body, TextField, FilledButton, GhostButton
} from "../components/all.slint";

export enum LoginStep {
    connecting,
    qr,
    phone,
    code,
    password,
    failed,
    setup,
    unavailable,
}

export struct LoginAction {
    label: string,
    filled: bool,
}

// Mirrors the zone constants in src/vm/login.rs.
export global LoginZones {
    out property <int> field: 70;
    out property <int> actions: 71;
}

export global LoginState {
    in property <LoginStep> step: LoginStep.connecting;
    in property <image> qr;
    in property <string> heading: "Connect your library";
    in property <string> status: "CONNECTING";
    in property <string> body;
    // The field's placeholder; empty hides the field.
    in property <string> placeholder;
    in property <bool> secret;
    in-out property <string> input;
    in property <[LoginAction]> actions;

    // Enter in the field.
    callback accepted(text: string);
}

export component LoginScreen inherits Rectangle {
    background: Tokens.canvas;

    HorizontalLayout {
        padding: Tokens.screen-padding;
        spacing: Tokens.space-xxl;
        alignment: center;

        if LoginState.step == LoginStep.qr: VerticalLayout {
            alignment: center;

            Rectangle {
                width: Tokens.qr-size;
                height: Tokens.qr-size;
                background: #FFFFFF;

                Image {
                    width: 100%;
                    height: 100%;
                    source: LoginState.qr;
                    image-fit: fill;
                    image-rendering: pixelated;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            width: 600px;

            Eyebrow {
                text: "TELEGRAM";
            }

            Rectangle {
                height: Tokens.space-xs;
            }

            Heading {
                text: LoginState.heading;
                wrap: word-wrap;
            }

            if LoginState.status != "": VerticalLayout {
                padding-top: Tokens.space-lg;

                Eyebrow {
                    text: LoginState.status;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }

            if LoginState.body != "": VerticalLayout {
                padding-top: Tokens.space-md;

                Body {
                    text: LoginState.body;
                    color: Tokens.text-secondary;
                    wrap: word-wrap;
                }
            }

            if LoginState.placeholder != "": HorizontalLayout {
                padding-top: Tokens.space-lg;
                alignment: start;

                TextField {
                    width: 320px;
                    text <=> LoginState.input;
                    placeholder: LoginState.placeholder;
                    input-type: LoginState.secret ? InputType.password : InputType.text;
                    zone: LoginZones.field;
                    index: 0;
                    accepted(text) => {
                        LoginState.accepted(text);
                    }
                }
            }

            if LoginState.actions.length > 0: HorizontalLayout {
                padding-top: Tokens.space-md;
                spacing: Tokens.space-md;
                alignment: start;

                for action[i] in LoginState.actions: HorizontalLayout {
                    if action.filled: FilledButton {
                        text: action.label;
                        zone: LoginZones.actions;
                        index: i;
                    }
                    if !action.filled: GhostButton {
                        text: action.label;
                        zone: LoginZones.actions;
                        index: i;
                    }
                }
            }
        }
    }
}
