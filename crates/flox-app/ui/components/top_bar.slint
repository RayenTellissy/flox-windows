// The Home top bar: ghost buttons (SEARCH · QUEUE (n) · LIBRARY · SETTINGS), all in
// one zone, and the Telegram status at the right: a square dot (terminal green when
// ready, disabled grey otherwise) with a mono label.
import { Tokens } from "../tokens.slint";
import { GhostButton } from "buttons.slint";
import { Eyebrow } from "text.slint";

export struct TopBarItem {
    label: string,
    icon: image,
}

export component TopBar inherits HorizontalLayout {
    in property <[TopBarItem]> items;
    in property <int> zone: -1;
    // The item drawn focused regardless of FocusState (gallery), or -1.
    in property <int> force-index: -1;
    in property <string> status-label;
    in property <bool> status-ready;

    spacing: Tokens.space-md;
    alignment: stretch;

    for item[i] in root.items: GhostButton {
        text: item.label;
        icon: item.icon;
        zone: root.zone;
        index: i;
        force-focus: i == root.force-index;
        horizontal-stretch: 0;
    }

    Rectangle {
        horizontal-stretch: 1;
    }

    if root.status-label != "": HorizontalLayout {
        spacing: Tokens.space-xs;
        horizontal-stretch: 0;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 0;
                background: root.status-ready ? Tokens.terminal-green : Tokens.text-disabled;
            }
        }

        VerticalLayout {
            alignment: center;

            Eyebrow {
                text: root.status-label;
                color: root.status-ready ? Tokens.text-secondary : Tokens.text-muted;
            }
        }
    }
}
